CO_API_KEY=tu-cohere-api-key
OCI_BUCKET_NAME=tu-nombre-de-tu-oci-bucket
OCI_NAMESPACE=                # vacío = lo obtiene automáticamente
OCI_REGION=tu-region-oci

# Alertas por correo. Sin SMTP_HOST o sin destinatarios no se envían avisos.
# Usa una contraseña de aplicación, nunca la clave normal de la cuenta.
SMTP_HOST=
SMTP_PUERTO=587                # 587 STARTTLS, 465 SSL
SMTP_USUARIO=
SMTP_CLAVE=
ALERTA_REMITENTE=
ALERTA_DESTINATARIOS=          # correos separados por coma
ALERTA_DESTINATARIOS_URGENTES= # se suman en urgencias y sospechas críticas
APP_URL=                       # enlace incluido en el correo

# Descomentar los siguientes para entrar en:
# Modo demo: Imprime logs en la consola

# MEDIFLOW_DEBUG_RAW=1

# Modo OCR PRIMERO: Extrae todos los caracteres de la imágen para luego
# comparar con los datos extraidos por el agente. Hace una llamada extra al
# agente de vision

# MEDIFLOW_OCR_PRIMERO=1
